# Allowlist .dockerignore — exclude everything, then re-include only what the app needs.
# Rationale: repo root contains many unrelated sibling projects (similarweb-research*,
# mobitoepub, neo4j, pdf-tools-site, backups, chroma_db) which made the build context 1.1GB.
# MUST stay LF-only: CRLF makes Docker read patterns as ".git\r" and match nothing.
*

# --- Python package/deps manifests ---
!requirements.txt

# --- Frontend build inputs (css stage) ---
!package.json
!package-lock.json
!tailwind.config.js
!babel.cfg

# --- Application entrypoints / top-level modules ---
!app.py
!main.py
!celery_app.py
!worker.py
!models.py
!sqlalchemy_models.py
!database.py
!database_service.py
!database_transaction_manager.py
!extensions.py
!forms.py
!schemas.py
!error_handlers.py
!event_handlers.py
!property_error_handlers.py
!background_matcher.py
!gemini_service.py
!maskan_field_constants.py
!vector_init.py
!vector_service.py
!environment_loader.py

# --- Application packages ---
# NOTE: api/ is deliberately NOT re-included. The api/ tree at the repo root is an
# untracked Node/Next.js sibling project (package.json, pages/, jsconfig.json) with
# zero Python files and zero importers in this app — re-including it added ~20MB of
# dead weight to the image.
!application/
!domain/
!infrastructure/
!repositories/
!services/
!tasks/
!utils/
!views/
!migrations/

# --- Assets / i18n / container scripts ---
!templates/
!static/
!translations/
!docker/

# --- Re-exclude junk that lives inside allowed dirs ---
templates/_archive/
**/__pycache__/
**/*.pyc
**/*.pyo
**/.pytest_cache/
**/node_modules/
static/uploads/**
!static/uploads/.gitkeep
